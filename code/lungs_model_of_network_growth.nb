Cell[CellGroupData[{

Cell["Generate data", "Subsection",
 CellChangeTimes->{{3.996054699726019*^9, 
  3.996054702432228*^9}},ExpressionUUID->"dc7e0c93-c631-3d4c-b774-\
9c3f01c3dd3f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "This", " ", "requires", " ", "the", 
    " ", "\"\<Simulation definition cell to be run first.\>\""}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "As", " ", "this", " ", "cell", " ", "involves", " ", "running", " ", 
     "simulations", " ", "with", " ", "large", " ", "final", " ", "times"}], ",",
     " ", 
    RowBox[{
    "it", " ", "may", " ", "take", " ", "more", " ", "than", " ", "an", " ", 
     "hour", " ", "to", " ", "execute"}], ",", " ", 
    RowBox[{
    "depending", " ", "on", " ", "the", " ", "available", " ", "CPU", " ", 
     RowBox[{"resources", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "The", " ", "code", " ", "may", " ", "throw", " ", "up", " ", "errors", " ",
      "because", " ", "for", " ", "small", " ", "networks"}], ",", " ", 
    RowBox[{
    "there", " ", "are", " ", "not", " ", "enough", " ", "nodes", " ", "to", " ",
      "generate", " ", "a", " ", "statistically", " ", "meaningful", " ", 
     "linear", " ", "fit", " ", "when", " ", "calculating", " ", 
     RowBox[{
      StyleBox[
       SubscriptBox["R", "b"],
       FontSlant->"Italic"], 
      StyleBox[".",
       FontSlant->"Italic"], 
      StyleBox[" ",
       FontSlant->"Italic"], "This"}], " ", "does", " ", "not", " ", "affect",
      " ", "most", " ", "of", " ", "the", " ", 
     RowBox[{"results", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"tipssim", ",", "bossim", ",", "data"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tmin", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tmax", "=", "13"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dt", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nsims", "=", "30"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"gx", "=", 
            RowBox[{"rtg", "[", "t", "]"}]}], ",", "tipssim", ",", "bossim", ",",
            "nbranches", ",", "rb", ",", "zsd", ",", "srftipfrac"}], "}"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"tipssim", "=", 
           RowBox[{"VertexList", "[", 
            RowBox[{"gx", ",", 
             RowBox[{"v_", "/;", 
              RowBox[{
               RowBox[{"VertexDegree", "[", 
                RowBox[{"gx", ",", "v"}], "]"}], "==", "1"}]}]}], "]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"bossim", "[", "v_", "]"}], ":=", 
           RowBox[{
            RowBox[{"bossim", "[", "v", "]"}], "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"VertexDegree", "[", 
                RowBox[{"gx", ",", "v"}], "]"}], "==", "1"}], ",", "1", ",", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Max", "[", "#", "]"}], "+", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"Equal", "@@", "#"}], ",", "1", ",", "0"}], 
                  "]"}]}], "&"}], "[", 
               RowBox[{"bossim", "/@", 
                RowBox[{"VertexOutComponent", "[", 
                 RowBox[{"gx", ",", "v", ",", 
                  RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}]}], "]"}]}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"nbranches", "=", 
           RowBox[{"EdgeCount", "[", "gx", "]"}]}], ";", 
          RowBox[{"(*", 
           RowBox[{
           "Used", " ", "to", " ", "calculate", " ", "conversion", " ", 
            "factor", " ", "of", " ", "simulation", " ", "time", " ", "units",
             " ", "to", " ", "experimental", " ", "time", " ", "units", " ", 
            RowBox[{
             RowBox[{"(", "PCW", ")"}], "."}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"rb", "=", 
           RowBox[{"Exp", "[", 
            RowBox[{"-", 
             RowBox[{
              RowBox[{
               RowBox[{"LinearModelFit", "[", 
                RowBox[{
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"w", ",", 
                    RowBox[{"Log", "@", 
                    RowBox[{"VertexCount", "[", 
                    RowBox[{"gx", ",", 
                    RowBox[{"v_", "/;", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"bossim", "[", "v", "]"}], "==", "w"}], "&&", 
                    RowBox[{
                    RowBox[{"bossim", "[", 
                    RowBox[{"First", "@", 
                    RowBox[{"VertexInComponent", "[", 
                    RowBox[{"gx", ",", "v", ",", 
                    RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}], ">", 
                    "w"}]}]}]}], "]"}]}]}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"w", ",", 
                    RowBox[{
                    RowBox[{"bossim", "[", "root", "]"}], "-", "1"}]}], 
                    "}"}]}], "]"}], ",", "x", ",", "x"}], "]"}], "'"}], "[", 
              "0", "]"}]}], "]"}]}], ";", 
          RowBox[{"(*", 
           RowBox[{"For", " ", 
            RowBox[{"Fig", ".", " ", "6"}], "e"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"zsd", "=", 
           RowBox[{"StandardDeviation", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "4"}], "]"}], "]"}], "&"}], "/@", 
             "tipssim"}], "]"}]}], ";", 
          RowBox[{"(*", 
           RowBox[{"For", " ", 
            RowBox[{"Fig", ".", " ", "6"}], "k"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"srftipfrac", "=", 
           FractionBox[
            RowBox[{"Count", "[", 
             RowBox[{"tipssim", ",", 
              RowBox[{"v_", "/;", 
               RowBox[{
                RowBox[{"v", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "3"}], "]"}], "]"}], "==", "0"}]}]}], 
             "]"}], 
            RowBox[{"Length", "[", "tipssim", "]"}]]}], ";", 
          RowBox[{"(*", 
           RowBox[{"For", " ", 
            RowBox[{"Fig", ".", " ", "6"}], "l"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
           "t", ",", "nbranches", ",", "rb", ",", "zsd", ",", "srftipfrac"}], 
           "}"}]}]}], "]"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tmin", ",", "tmax", ",", "dt"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "nsims"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Uncomment", " ", "following", " ", "line", " ", "to", " ", "save", " ", 
     RowBox[{"data", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Export", "[", 
      RowBox[{"\"\<../data/file_name.csv\>\"", ",", "data", 
       ",", "\"\<CSV\>\""}], "]"}], ";"}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.996053373472925*^9, 3.9960536021381607`*^9}, {
   3.9960536437124577`*^9, 3.996053737708666*^9}, {3.9960537746306057`*^9, 
   3.9960539650261364`*^9}, {3.9960540543039646`*^9, 
   3.9960541283528767`*^9}, {3.9960546034874115`*^9, 
   3.9960546831411457`*^9}, {3.9960558640616913`*^9, 
   3.9960560106749516`*^9}, {3.9960562086791477`*^9, 3.996056216092272*^9}, {
