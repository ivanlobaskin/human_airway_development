45674392a7a0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Convert", " ", "simulation", " ", "time", " ", "units", " ", "to", " ", 
    "experimental", " ", "time", " ", "units", " ", 
    RowBox[{"(", "PCW", ")"}], " ", "by", " ", "comparing", " ", "number", " ",
     "of", " ", 
    RowBox[{"branches", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nbranches", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"ToExpression", "@", 
        RowBox[{
        "Import", "[", "\"\<../data/numbers_of_branches.xlsx\>\"", "]"}]}], 
       ")"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "All", ",", 
        RowBox[{"2", ";;"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fitexp", "=", 
     RowBox[{"LinearModelFit", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"nbranches", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"Log", "@", 
           RowBox[{"nbranches", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], "//", "Transpose"}], ",",
        "t", ",", "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fitsim", "=", 
     RowBox[{"LinearModelFit", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Flatten", "@", 
           RowBox[{"data", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "All", ",", "1"}], "]"}], "]"}]}], ",", 
          RowBox[{"Log", "@", 
           RowBox[{"Flatten", "@", 
            RowBox[{"data", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}]}]}]}], 
         "}"}], "//", "Transpose"}], ",", "t", ",", "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"convert", "[", "t_", "]"}], ":=", 
     RowBox[{"First", "[", 
      RowBox[{"s", "/.", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"fitexp", "[", "s", "]"}], "==", 
          RowBox[{"fitsim", "[", "t", "]"}]}], ",", "s"}], "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Simulation times (PCW equivalent): \>\"", ",", 
     RowBox[{"convert", "/@", 
      RowBox[{"data", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1", ",", "1"}], "]"}], "]"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{
  3.9960543144721622`*^9, {3.996054488497635*^9, 3.996054501139307*^9}, {
   3.9960547189116917`*^9, 3.996054739631731*^9}, {3.996056232206272*^9, 
