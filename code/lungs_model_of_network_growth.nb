     RowBox[{"findT", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"VertexCount", "[", 
         RowBox[{"rtg", "[", "#", "]"}], "]"}], "&"}], ",", 
       RowBox[{"VertexCount", "[", "gr", "]"}], ",", "5", ",", "10"}], "]"}], 
     "[", "\"\<t\>\"", "]"}]}], ";"}]}]], "Input",
