   3.9960640709224625`*^9}, {3.9965580091493053`*^9, 
   3.9965580122537556`*^9}, {3.997335890299692*^9, 3.99733589953158*^9}, {
   3.9973582790553226`*^9, 3.997358297774767*^9}},
