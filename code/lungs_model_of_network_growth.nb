Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Find", " ", "the", " ", "value", " ", "of", " ", "T", " ", "for", " ", 
    "which", " ", 
    RowBox[{"rtg", "[", "T", "]"}], " ", "generates", " ", "a", " ", "tree", " ",
     "with", " ", "the", " ", "same", " ", "number", " ", "of", " ", 
    "branches", " ", "as", " ", 
    RowBox[{"gr", "."}]}], "*)"}], "\[IndentingNewLine]", 
