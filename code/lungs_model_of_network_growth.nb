Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ltorootsim", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ltorootsim", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"ltorootsim", "[", 
     RowBox[{"i", ",", "j"}], "]"}], "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"j", "==", "root"}], ",", "0", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"branchlensim", "[", 
         RowBox[{"i", ",", "j"}], "]"}], "/", "1000"}], "+", 
       RowBox[{"ltorootsim", "[", 
        RowBox[{"i", ",", 
         RowBox[{"getpsim", "[", 
          RowBox[{"i", ",", "j"}], "]"}]}], "]"}]}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tipssim", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"gx", "=", 
         RowBox[{"gsimulated", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"VertexList", "[", 
        RowBox[{"gx", ",", 
         RowBox[{"j_", "/;", 
          RowBox[{
           RowBox[{"VertexDegree", "[", 
            RowBox[{"gx", ",", "j"}], "]"}], "==", "1"}]}]}], "]"}]}], "]"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "nsims"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tipssimgens", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "4"}], "]"}], "]"}], "&"}], "/@", 
      RowBox[{"tipssim", "[", 
       RowBox[{"[", "i", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "nsims"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trlsim", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"ltorootsim", "[", 
        RowBox[{"i", ",", "#"}], "]"}], "&"}], "/@", 
      RowBox[{"tipssim", "[", 
       RowBox[{"[", "i", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "nsims"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
