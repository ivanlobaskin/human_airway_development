745ddf6574e7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Note", " ", "that", " ", "tip"}], "-", "to", "-", 
     RowBox[{
     "root", " ", "length", " ", "is", " ", "measured", " ", "in", " ", 
      "mm"}]}], ",", " ", 
    RowBox[{
    "whereas", " ", "branch", " ", "length", " ", "in", " ", "\[Mu]m"}], ",", 
    " ", 
    RowBox[{
    "so", " ", "a", " ", "conversion", " ", "factor", " ", "of", " ", "1000", 
     " ", "is", " ", 
     RowBox[{"included", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "ltorootsim", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ltorootsim", "[", 
      RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"ltorootsim", "[", 
       RowBox[{"i", ",", "j"}], "]"}], "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"j", "==", "root"}], ",", "0", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"branchlensim", "[", 
           RowBox[{"i", ",", "j"}], "]"}], "/", "1000"}], "+", 
         RowBox[{"ltorootsim", "[", 
          RowBox[{"i", ",", 
           RowBox[{"getpsim", "[", 
            RowBox[{"i", ",", "j"}], "]"}]}], "]"}]}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tipssim", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"gx", "=", 
           RowBox[{"gsimulated", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"VertexList", "[", 
          RowBox[{"gx", ",", 
           RowBox[{"j_", "/;", 
            RowBox[{
             RowBox[{"VertexDegree", "[", 
              RowBox[{"gx", ",", "j"}], "]"}], "==", "1"}]}]}], "]"}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nsims"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trlsim", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ltorootsim", "[", 
          RowBox[{"i", ",", "#"}], "]"}], "&"}], "/@", 
        RowBox[{"tipssim", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nsims"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trlmin", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trlmax", "=", "4"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nsteps", "=", "100"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trlrange", "=", 
     RowBox[{"Subdivide", "[", 
      RowBox[{"trlmin", ",", "trlmax", ",", "nsteps"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pdfs", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"PDF", "[", 
         RowBox[{
          RowBox[{"SmoothKernelDistribution", "[", 
           RowBox[{"trlsim", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", "#"}], "]"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nsims"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hist", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Mean", "[", "#", "]"}], ",", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"1.96", " ", 
              RowBox[{"StandardDeviation", "[", "#", "]"}]}], ",", 
             RowBox[{"10", "^", 
              RowBox[{"-", "10"}]}]}], "]"}]}], "}"}], "&"}], "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"pdfs", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", "x", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "nsims"}], "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "trlrange"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Tip-to-root length bins: \>\"", ",", 
     RowBox[{"trlrange", "//", "N"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Tip-to-root length count, means: \>\"", ",", 
     RowBox[{
      RowBox[{"hist", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "//", "N"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Tip-to-root length count, errors: \>\"", ",", 
     RowBox[{
      RowBox[{"hist", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "//", "N"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.995975420472948*^9, 3.9959755610447063`*^9}, {
