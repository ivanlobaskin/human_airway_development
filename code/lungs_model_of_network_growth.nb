   3.9742698159488277`*^9, 3.9742698340151787`*^9}, {3.9742705218526917`*^9, 
   3.974270522140257*^9}, 3.974281080521372*^9, {3.9743659391651*^9, 
   3.974365939455744*^9}, 3.9743663330587845`*^9, 3.9743663782905254`*^9, {
