   3.995969767955759*^9, {3.9973357001248035`*^9, 3.9973357308601*^9}},
 CellLabel->
  "In[279]:=",ExpressionUUID->"26893030-b49e-9b49-af46-181fd34a303d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Convert simulation length scale and expansion rate to experiment equivalents\
\>", "Section",
 CellChangeTimes->{{3.9957181021111946`*^9, 3.9957181204630737`*^9}, {
  3.99571822768305*^9, 3.995718235966219*^9}, {3.995973697243313*^9, 
  3.995973720730583*^9}, {3.996041432191427*^9, 3.996041441950718*^9}, {
  3.9965572238581314`*^9, 3.996557263888756*^9}, {3.9975142946646023`*^9, 
  3.9975142957810135`*^9}},ExpressionUUID->"854ca6c9-977d-d049-9979-\
ea4ad520f207"],

Cell[TextData[{
 "To determine the lengths of branch ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "d1d76601-3538-e84b-8cd9-12f6d78dd8ad"],
 ", the following rule is used (see Methods for further details): \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["l", "i"], "=", 
     TagBox[GridBox[{
        {"\[Piecewise]", GridBox[{
           {
            RowBox[{
             RowBox[{
              SubscriptBox["v", 
               SubscriptBox["Q", "i"]], 
              SubscriptBox["\[Tau]", "i"]}], ","}], 
            RowBox[{"w", "<=", "2"}]},
           {
            RowBox[{
             RowBox[{
              SubscriptBox["v", 
               SubscriptBox["Q", "i"]], 
              SubscriptBox["\[Tau]", "i"], 
              SuperscriptBox["e", 
               RowBox[{
                SubscriptBox["\[Lambda]", "exp"], "(", 
                RowBox[{"T", "-", 
                 SubscriptBox["t", "i"]}], ")"}]]}], ","}], 
            RowBox[{"w", ">", "2"}]}
          },
          AllowedDimensions->{2, Automatic},
          Editable->True,
          GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
          GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
          GridBoxSpacings->{"Columns" -> {
              Offset[0.27999999999999997`], {
               Offset[0.84]}, 
              Offset[0.27999999999999997`]}, "Rows" -> {
              Offset[0.2], {
               Offset[0.4]}, 
              Offset[0.2]}},
          Selectable->True]}
       },
       GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
       GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[0.35]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}],
      "Piecewise",
      DeleteWithContents->True,
      Editable->False,
      SelectWithContents->True,
      Selectable->False,
      StripWrapperBoxes->True]}], " ", ","}], TraditionalForm]],
  InitializationCell->True,ExpressionUUID->
  "dbbfc939-3ae8-c04f-b949-22bfa25d0476"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "Q"], TraditionalForm]],ExpressionUUID->
  "341c42da-565e-b549-9be3-e30798761ae4"],
 " is the elongation speed, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "i"], TraditionalForm]],ExpressionUUID->
  "1c09568d-aadb-4e48-8826-f1cf7f815465"],
 " is the species (surface or bulk), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Tau]", "i"], TraditionalForm]],ExpressionUUID->
  "9bcc5801-56e2-7547-b822-2699fc71aed6"],
 " is the branch time, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "exp"], TraditionalForm]],ExpressionUUID->
  "9528db1c-70a1-c746-99e4-5c6044e58c50"],
 " is the expansion rate, ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],ExpressionUUID->
  "2d8b181d-c2bc-414f-bfbd-68bcb2892433"],
 " is the total simulation time, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "i"], TraditionalForm]],ExpressionUUID->
  "0f2276e5-a7ce-c34c-a30d-e2d33e4f6097"],
 " is the elapsed time at the time of creation of that branch, and ",
 Cell[BoxData[
  FormBox["w", TraditionalForm]],ExpressionUUID->
  "7fdf9ff8-6188-554d-b510-a34d843bdb80"],
 " is branch order (Strahler).\n\nThe elongation speeds ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "S"], TraditionalForm]],ExpressionUUID->
  "55ffb754-a948-c74b-977c-b23980e0cc02"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "B"], TraditionalForm]],ExpressionUUID->
  "3ed5be07-b9ef-6c43-bb6c-4cef076ff032"],
 " for the simulation are determined by dividing the mean order 2 branch \
lengths in the CN and AS respectively from the experimental data by the mean \
branch time of order 2 branches in simulations.\n\nTo determine the expansion \
rate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "exp"], TraditionalForm]],ExpressionUUID->
  "0ddd7cf4-7694-9b4e-9e7e-508c22ae2a21"],
 ", we first extract the scaling of branch lengths with order (Strahler), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "w"], TraditionalForm]],ExpressionUUID->
  "b1315286-d7b2-e44c-811b-71e4ad6c3c29"],
 ", in the experimental data, which follows an exponential law, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"\[LeftAngleBracket]", "l", "\[RightAngleBracket]"}], "w"], "=", 
    RowBox[{
     SubscriptBox["l", "0"], 
     SuperscriptBox["e", 
      RowBox[{
       SubscriptBox["\[Lambda]", "w"], "w"}]]}]}], TraditionalForm]],
  ExpressionUUID->"62bf25f1-8bc7-8749-8652-f28a15ba6e18"],
 ". Then, we measure the average elapsed time for a branch at order ",
 Cell[BoxData[
  FormBox["w", TraditionalForm]],ExpressionUUID->
  "8cc8b2ac-2af2-374a-809a-f14d2d24851e"],
 " in the simulations, which follows a linear relation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"\[LeftAngleBracket]", "t", "\[RightAngleBracket]"}], "w"], "=", 
    RowBox[{
     SubscriptBox["t", "0"], "-", 
     RowBox[{"m", " ", "w"}]}]}], TraditionalForm]],ExpressionUUID->
  "5f37a6cb-b845-2143-8cb8-3d1d9fbd1491"],
 ". Then the expansion rate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "exp"], TraditionalForm]],ExpressionUUID->
  "234b78ef-bbcd-9a4b-a8a6-54d2cf37f66f"],
 " in (inverse) simulation time units can be estimated as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", "exp"], "=", 
    RowBox[{
     SubscriptBox["\[Lambda]", "w"], "/", "m"}]}], TraditionalForm]],
  ExpressionUUID->"b4d4101b-1b6e-6347-9654-1a30399082d6"],
 "."
}], "Text",
 CellChangeTimes->{{3.9959659973162155`*^9, 3.995966267603895*^9}, {
  3.9959670805133934`*^9, 3.9959671094627724`*^9}, {3.9959671651807594`*^9, 
  3.9959671944667416`*^9}, {3.995967227000044*^9, 3.995967390063877*^9}, {
  3.9959674206739044`*^9, 3.9959674613290863`*^9}, {3.995967527589115*^9, 
  3.9959675680173607`*^9}, {3.995967602944689*^9, 3.9959678402926598`*^9}, {
  3.9959678703428307`*^9, 3.995967933586149*^9}, {3.9959702560125847`*^9, 
  3.9959702601266537`*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"a98567d7-a9d9-464c-aa48-f8dde85fc06d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Determine", " ", "lengths", " ", 
    RowBox[{"(", 
     RowBox[{"equivalently", ",", " ", 
      RowBox[{"elongation", " ", "rates"}]}], ")"}], " ", "of", " ", 
    "surface", " ", "and", " ", "bulk", " ", "tips", " ", "from", " ", "mean",
     " ", "length", " ", "of", " ", "order", " ", "2", " ", "branches", " ", 
    "in", " ", "core", " ", "network", " ", "and", " ", "ancilary", " ", 
    "subtrees", " ", 
    RowBox[{"respectively", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"lengthss", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"getpl", "/@", 
       RowBox[{"Cases", "[", 
        RowBox[{"corenetwork", ",", 
         RowBox[{"i_", "/;", 
          RowBox[{
           RowBox[{"bos", "[", "i", "]"}], "==", "2"}]}]}], "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lengthsb", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"getpl", "/@", 
       RowBox[{"Cases", "[", 
        RowBox[{"ancilarysubtrees", ",", 
         RowBox[{"i_", "/;", 
          RowBox[{
           RowBox[{"bos", "[", "i", "]"}], "==", "2"}]}]}], "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"stimesim", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", 
          RowBox[{
           RowBox[{"gsimulated", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"j_", "/;", 
              RowBox[{
               RowBox[{"j", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "3"}], "]"}], "]"}], "==", "0"}]}], ")"}], 
            ":>", 
            RowBox[{"j", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2"}], "]"}], "]"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "nsims"}], "}"}]}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"btimesim", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", 
          RowBox[{
           RowBox[{"gsimulated", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"j_", "/;", 
              RowBox[{
               RowBox[{"j", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "3"}], "]"}], "]"}], "==", "1"}]}], ")"}], 
            ":>", 
            RowBox[{"j", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2"}], "]"}], "]"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "nsims"}], "}"}]}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vs", "=", 
     RowBox[{"lengthss", "/", "stimesim"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vb", "=", 
     RowBox[{"lengthsb", "/", "btimesim"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"root", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"getpsim", ",", "bossim"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"getpsim", "[", 
      RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"getpsim", "[", 
       RowBox[{"i", ",", "j"}], "]"}], "=", 
      RowBox[{"First", "[", 
       RowBox[{"VertexInComponent", "[", 
        RowBox[{
         RowBox[{"gsimulated", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", "j", ",", 
         RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"bossim", "[", 
      RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"bossim", "[", 
       RowBox[{"i", ",", "j"}], "]"}], "=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"gx", "=", 
          RowBox[{"gsimulated", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"VertexDegree", "[", 
            RowBox[{"gx", ",", "j"}], "]"}], "==", "1"}], ",", "1", ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Max", "[", "#", "]"}], "+", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"Equal", "@@", "#"}], ",", "1", ",", "0"}], "]"}]}], 
            "&"}], "[", 
           RowBox[{
            RowBox[{
             RowBox[{"bossim", "[", 
              RowBox[{"i", ",", "#"}], "]"}], "&"}], "/@", 
            RowBox[{"VertexOutComponent", "[", 
             RowBox[{"gx", ",", "j", ",", 
              RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}]}], "]"}]}], "]"}]}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wmax", "=", 
     RowBox[{"Max", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"bossim", "[", 
         RowBox[{"i", ",", "root"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "nsims"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wrange", "=", 
     RowBox[{"Range", "[", "wmax", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Determine", " ", "expansion", " ", "rate", " ", 
     RowBox[{"(", 
      RowBox[{
      "with", " ", "respect", " ", "to", " ", "branch", " ", "order"}], ")"}],
      " ", "using", " ", "scaling", " ", "of", " ", "core", " ", "network", " ",
      "branch", " ", 
     RowBox[{"lengths", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Order", " ", "1", " ", "and", " ", "highest", " ", "order", " ", 
      "branches", " ", "are", " ", "excluded"}], ",", " ", 
     RowBox[{
     "as", " ", "they", " ", "typically", " ", "do", " ", "not", " ", 
      "follow", " ", "the", " ", "scaling", " ", "trend", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"see", " ", 
         RowBox[{"Fig", ".", " ", "5"}], "i"}], ")"}], "."}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Ancilary", " ", "subtree", " ", "branches", " ", "are", " ", "assumed", " ",
      "to", " ", "expand", " ", "with", " ", "the", " ", "same", " ", 
     RowBox[{"rate", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fit", "=", 
     RowBox[{"LinearModelFit", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"w", ",", 
           RowBox[{"Log", "@", 
            RowBox[{"Mean", "[", 
             RowBox[{"Cases", "[", 
              RowBox[{"corenetwork", ",", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"i_", "/;", 
                  RowBox[{
                   RowBox[{"bos", "[", "i", "]"}], "==", "w"}]}], ")"}], ":>", 
                RowBox[{"getpl", "[", "i", "]"}]}]}], "]"}], "]"}]}]}], "}"}],
          ",", 
         RowBox[{"{", 
          RowBox[{"w", ",", "2", ",", 
           RowBox[{
            RowBox[{"bos", "[", "1", "]"}], "-", "1"}]}], "}"}]}], "]"}], ",",
        "x", ",", "x"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]w", "=", 
     RowBox[{
      RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Determine", " ", "the", " ", "\"\<time elapsed per order\>\"", " ", 
      "parameter"}], ",", " ", 
     RowBox[{"m", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fits", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"LinearModelFit", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Mean", "[", 
            RowBox[{"VertexList", "[", 
             RowBox[{
              RowBox[{"gsimulated", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"v_", "/;", 
                 RowBox[{
                  RowBox[{"bossim", "[", 
                   RowBox[{"i", ",", "v"}], "]"}], "==", "w"}]}], ")"}], ":>", 
               RowBox[{"v", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"w", ",", 
             RowBox[{"bossim", "[", 
              RowBox[{"i", ",", "root"}], "]"}]}], "}"}]}], "]"}], ",", "x", ",",
          "x"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nsims"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"m", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"f", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"f", ",", "fits"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Determine", " ", "expansion", " ", "rate", " ", "in", " ", "simulation", 
     " ", "time", " ", 
     RowBox[{"units", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]exp", "=", 
     RowBox[{"\[Lambda]w", "/", "m"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "branch", " ", "length", " ", 
     RowBox[{"function", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "branchlensim", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"branchlensim", "[", 
      RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"branchlensim", "[", 
       RowBox[{"i", ",", "j"}], "]"}], "=", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"j", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "3"}], "]"}], "]"}], "==", "0"}], ",", "vs", ",",
          "vb"}], "]"}], 
       RowBox[{"j", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}], 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"bossim", "[", 
           RowBox[{"i", ",", "j"}], "]"}], "<=", "2"}], ",", "1", ",", 
         RowBox[{"Exp", "[", 
          RowBox[{"\[Lambda]exp", 
           RowBox[{"(", 
            RowBox[{"bestT", "-", 
             RowBox[{"j", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ")"}]}], "]"}]}], 
        "]"}]}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9959606961552715`*^9, 3.9959608286789513`*^9}, 
   3.9959625562314663`*^9, {3.995965654083273*^9, 3.9959659808028316`*^9}, {
   3.995967477626753*^9, 3.9959674848658466`*^9}, {3.9959675515785656`*^9, 
   3.9959675517790337`*^9}, {3.995967729328287*^9, 3.995967729699465*^9}, {
   3.9959680307851887`*^9, 3.995968265888691*^9}, {3.995968403807863*^9, 
   3.9959685159911404`*^9}, {3.9959686468854218`*^9, 3.995968654914461*^9}, {
   3.995970275885977*^9, 3.995970333043911*^9}, {3.9959703816285133`*^9, 
   3.9959704142042828`*^9}, {3.995970726897337*^9, 3.9959707357402134`*^9}, {
   3.9959707973879623`*^9, 3.9959708192295837`*^9}, {3.995970875747486*^9, 
   3.9959709776926937`*^9}, {3.9959710236669655`*^9, 
   3.9959711448040085`*^9}, {3.9959712732304916`*^9, 
   3.9959712889583607`*^9}, {3.9959713665102425`*^9, 
   3.9959713888668537`*^9}, {3.9959722239403896`*^9, 3.995972230371746*^9}, {
   3.995973238832176*^9, 3.995973483005499*^9}, {3.9959735343933315`*^9, 
   3.99597358381822*^9}, {3.9959737411139107`*^9, 3.9959737425898705`*^9}, {
   3.9965632244684887`*^9, 3.9965632522250633`*^9}, {3.99656372734552*^9, 
   3.9965638607372894`*^9}, {3.996565557805605*^9, 3.9965655638204937`*^9}},
 CellLabel->
  "In[318]:=",ExpressionUUID->"ef0e544b-9851-984f-a4e0-bb6e05e75758"]
}, Open  ]],

