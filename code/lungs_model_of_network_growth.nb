Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"root", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"getpsim", ",", "bossim"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"getpsim", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"getpsim", "[", 
     RowBox[{"i", ",", "j"}], "]"}], "=", 
    RowBox[{"First", "[", 
     RowBox[{"VertexInComponent", "[", 
      RowBox[{
       RowBox[{"gsimulated", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", "j", ",", 
       RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bossim", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"bossim", "[", 
     RowBox[{"i", ",", "j"}], "]"}], "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"gx", "=", 
        RowBox[{"gsimulated", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexDegree", "[", 
          RowBox[{"gx", ",", "j"}], "]"}], "==", "1"}], ",", "1", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", "#", "]"}], "+", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"Equal", "@@", "#"}], ",", "1", ",", "0"}], "]"}]}], 
          "&"}], "[", 
         RowBox[{
          RowBox[{
           RowBox[{"bossim", "[", 
            RowBox[{"i", ",", "#"}], "]"}], "&"}], "/@", 
          RowBox[{"VertexOutComponent", "[", 
           RowBox[{"gx", ",", "j", ",", 
            RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}]}], "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wmax", "=", 
   RowBox[{"Max", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"bossim", "[", 
       RowBox[{"i", ",", "root"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "nsims"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wrange", "=", 
   RowBox[{"Range", "[", "wmax", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nw", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Mean", "[", "#", "]"}], ",", 
         RowBox[{"1.96", 
          RowBox[{"StandardDeviation", "[", "#", "]"}]}]}], "}"}], "&"}], "@", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"gx", "=", 
            RowBox[{"gsimulated", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"VertexCount", "[", 
           RowBox[{"gx", ",", 
            RowBox[{"j_", "/;", 
             RowBox[{
              RowBox[{
               RowBox[{"bossim", "[", 
                RowBox[{"i", ",", "j"}], "]"}], "==", "w"}], "&&", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"bossim", "[", 
                  RowBox[{"i", ",", 
                   RowBox[{"getpsim", "[", 
                    RowBox[{"i", ",", "j"}], "]"}]}], "]"}], ">", "w"}], " ", 
                "||", 
                RowBox[{"j", "==", "root"}]}], ")"}]}]}]}], "]"}]}], "]"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "nsims"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"w", ",", "wmax"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Orders: \>\"", ",", "wrange"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Number of branches, mean: \>\"", ",", 
   RowBox[{
    RowBox[{"nw", "[", 
