Cell[CellGroupData[{

Cell["Determine simulation time (for single sample)", "Subsection",
 CellChangeTimes->{{3.9957009610925236`*^9, 3.995700973015152*^9}, {
  3.9957060525909576`*^9, 3.9957060596181126`*^9}, {3.996051044098522*^9, 
  3.9960510505515785`*^9}},ExpressionUUID->"a47abe3d-a05e-644d-92e2-\
ef584b3bba4d"],

Cell[TextData[{
 "This code runs the simulation for different total times T, until it finds a \
T for which the geometric mean of the number of nodes is within a ",
 StyleBox["tolerance",
  FontSlant->"Italic"],
 " of the ",
 StyleBox["target",
  FontSlant->"Italic"],
 " value.\n\nNote that one could alternatively follow the procedure used for \
replicating simulation results across many time points to determine the unit \
conversion between simulation time and experiment time and choose the \
simulation time correspondingly. However, as there is some uncertainty in the \
measured sample ages, the simulations may not match a given sample as closely."
}], "Text",
 CellChangeTimes->{{3.9957049598425274`*^9, 3.99570509215884*^9}, {
   3.99595956559568*^9, 3.9959597353202133`*^9}, 3.996037725429693*^9, 
   3.9960379575939865`*^9},
 Background->GrayLevel[
  0.85],ExpressionUUID->"75acb9ac-2386-084a-8593-db78b5852e8d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "findT", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"findT", "[", 
    RowBox[{"simulate_", ",", "target_", ",", 
     RowBox[{"t1_", ":", "5."}], ",", 
     RowBox[{"t2_", ":", "10."}], ",", 
     RowBox[{"pilotRuns_", ":", "10"}], ",", 
     RowBox[{"maxIter_", ":", "10"}], ",", 
     RowBox[{"tolerance_", ":", ".05"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"data", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"t", "=", "t1"}], ",", "runs", ",", "logs", ",", "gm", ",", 
       "fit", ",", "b", ",", "a", ",", "newt", ",", "lower", ",", "upper", ",", 
       RowBox[{"batch", "=", "pilotRuns"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Generate", " ", "an", " ", "initial", " ", "point", " ", "and", " ", 
       "then", " ", "iteratively", " ", 
       RowBox[{"refine", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"runs", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"simulate", "[", "t", "]"}], ",", 
            RowBox[{"{", "batch", "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"logs", "=", 
          RowBox[{"Log", "[", "runs", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"data", ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", 
             RowBox[{"Mean", "[", "logs", "]"}]}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"gm", "=", 
          RowBox[{"Exp", "[", 
           RowBox[{"Mean", "[", "logs", "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<t = \>\"", ",", "t", ",", "\"\<, geometric mean = \>\"",
            ",", 
           RowBox[{"N", "[", "gm", "]"}], ",", "\"\<, relative error = \>\"", 
           ",", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"gm", "/", "target"}], "-", "1"}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Stop", " ", "if", " ", 
           RowBox[{"we", "'"}], "re", " ", "within", " ", "the", " ", 
           "requested", " ", "tolerance"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"gm", "/", "target"}], "-", "1"}], "]"}], "<", 
            "tolerance"}], ",", 
           RowBox[{"Return", "[", 
            RowBox[{
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<t\>\"", "->", "t"}], ",", 
               RowBox[{
                RowBox[{"\"\<GeometricMean\>\"", "->", "gm"}], "//", "N"}], ",", 
               RowBox[{
                RowBox[{"\"\<Data\>\"", "->", "data"}], "//", "N"}], ",", 
               RowBox[{"\"\<RunsAtFinalT\>\"", "->", "runs"}]}], "|>"}], ",", 
             "Module"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Fit", " ", "log", 
           RowBox[{"(", "GM", ")"}], " ", "as", " ", "a", " ", "function", " ",
            "of", " ", "t"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "data", "]"}], ">=", "2"}], ",", 
           RowBox[{
            RowBox[{"fit", "=", 
             RowBox[{"LinearModelFit", "[", 
              RowBox[{"data", ",", "x", ",", "x"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"a", "=", 
             RowBox[{
              RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"b", "=", 
             RowBox[{
              RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
               RowBox[{"Solve", " ", "a"}], "+", 
               RowBox[{"b", " ", "t"}]}], "=", 
              RowBox[{"log", 
               RowBox[{"(", "target", ")"}]}]}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"newt", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Log", "[", "target", "]"}], "-", "a"}], ")"}], "/", 
              "b"}]}], ";"}], ",", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"First", " ", 
             RowBox[{"step", ":", 
              RowBox[{"perturb", " ", "t"}]}]}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"newt", "=", "t2"}], ";"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"t", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"0", ",", "newt"}], "]"}]}]}], ",", 
        RowBox[{"{", "maxIter", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<t\>\"", "->", "t"}], ",", 
        RowBox[{
         RowBox[{"\"\<GeometricMean\>\"", "->", "gm"}], "//", "N"}], ",", 
        RowBox[{
         RowBox[{"\"\<Data\>\"", "->", "data"}], "//", "N"}], ",", 
        RowBox[{"\"\<RunsAtFinalT\>\"", "->", "runs"}]}], "|>"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9957023482653217`*^9, 3.995702502107847*^9}, {
   3.9957032952388096`*^9, 3.99570329653273*^9}, {3.9957033780099087`*^9, 
   3.995703420406204*^9}, {3.9957034974455853`*^9, 3.9957035404493847`*^9}, {
   3.995703721886183*^9, 3.995703848403904*^9}, 3.9957038823610134`*^9, {
   3.9957039869805183`*^9, 3.9957039888548565`*^9}, 3.995704398998745*^9, {
   3.995704457055956*^9, 3.99570446957082*^9}, {3.99570456230694*^9, 
   3.9957045905206604`*^9}, {3.9957048169145927`*^9, 3.995704821876892*^9}, {
   3.995704904292631*^9, 3.9957049080078506`*^9}, {3.995704966662613*^9, 
   3.995704966732744*^9}, {3.995705901522253*^9, 3.9957059207754536`*^9}, 
   3.9960453421448803`*^9},
 CellLabel->
  "In[276]:=",ExpressionUUID->"56d3f04c-482d-1140-b4c0-8cfba79da46d"],

