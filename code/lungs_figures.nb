  3.996315816441492*^9}},ExpressionUUID->"ae6283ae-a85d-d847-8233-\
4ddaa82f71c2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"regularize", "=", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "<", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", 
       RowBox[{"Around", "[", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", 
            RowBox[{"10", "^", 
             RowBox[{"-", "10"}]}]}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ",", "#"}], 
      "]"}], "&"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "prevent", " ", "machine", " ", "error", " ", 
    "from", " ", "infinite", " ", 
    RowBox[{"errorbars", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"lrange", ",", "exppdf"}], "}"}]}], "]"}], ",", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#1", ",", 
          RowBox[{"regularize", "@", 
           RowBox[{"Around", "[", 
            RowBox[{"#2", ",", "#3"}], "]"}]}]}], "}"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"lrange", ",", "simpdfmean", ",", "simpdferr"}], "}"}]}], 
      "]"}]}], "}"}], ",", "\[IndentingNewLine]", "graphsettings", ",", 
   RowBox[{"ScalingFunctions", "->", "\"\<Log10\>\""}], ",", 
   RowBox[{"PlotRangePadding", "->", "None"}], ",", 
   RowBox[{"IntervalMarkers", "->", "\"\<Bands\>\""}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "300"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"10", "^", 
         RowBox[{"-", "5"}]}], ",", 
        RowBox[{"10", "^", 
         RowBox[{"-", "1"}]}]}], "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Surface tip length difference (\[Mu]m)\>\"", 
      ",", "\"\<Probability distribution\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Experiment\>\"", ",", "\"\<Simulation (BD)\>\""}], "}"}], 
      ",", 
      RowBox[{"{", 
