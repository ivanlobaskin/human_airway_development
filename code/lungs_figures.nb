Cell[CellGroupData[{

Cell["Generate log-linear fit", "Subsection",
 CellChangeTimes->{{3.9868995944553814`*^9, 
  3.9868996061255302`*^9}},ExpressionUUID->"da2e9f28-ea41-fb45-98cb-\
b70671d6d5bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fit", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ages", ",", 
        RowBox[{"Log", "@", "nbranches"}]}], "}"}], "\[Transpose]"}], ",", 
     "a", ",", "a"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.986899620792341*^9, 3.9868996491970825`*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"60d0555a-1b01-9346-855e-950d18b8835a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Generate plot", "Subsection",
 CellChangeTimes->{{3.9868996248418427`*^9, 
  3.9868996357353954`*^9}},ExpressionUUID->"809c7472-bd0b-5b47-afa3-\
6ce4d6143f48"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ages", ",", "nbranches"}], "}"}], "\[Transpose]"}], ",", 
     "graphsettings", ",", 
     RowBox[{"ScalingFunctions", "->", "\"\<Log10\>\""}], ",", 
     RowBox[{"PlotMarkers", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<OpenMarkers\>\"", ",", "6"}], "}"}]}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Age (PCW)\>\"", 
        ",", "\"\<Number of branhces, \
\!\(\*StyleBox[\"N\",FontSlant->\"Italic\"]\)\>\""}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"4", ",", "14"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"10", "^", "0"}], ",", 
          RowBox[{"10", "^", "5"}]}], "}"}]}], "}"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", 
         RowBox[{"Exp", "@", 
          RowBox[{"fit", "[", "\"\<BestFitAround\>\"", "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"a", ",", "5.7", ",", "12", ",", "0.1"}], "}"}]}], "]"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Thickness", "[", "0.008", "]"}]}], ",", 
     RowBox[{"ScalingFunctions", "->", "\"\<Log10\>\""}], ",", 
     RowBox[{"IntervalMarkers", "->", "\"\<Bands\>\""}]}], "]"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.986899653311693*^9, 3.9868996930337677`*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"0bd506fc-671a-3b40-8151-90d0d609fd3a"],

