Cell["\<\
Note that angles are saved in radians, so need to be converted to degrees for \
plot.
Rescale angles onto [0,90\[Degree]) range.\
\>", "Text",
 CellChangeTimes->{{3.987657171099863*^9, 
  3.987657233606987*^9}},ExpressionUUID->"e653ba69-8090-8440-908e-\
5933853a0d66"],

