d05c77095370"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sdlogtrl7", "=", 
   RowBox[{"Pick", "[", 
    RowBox[{"sdlogtrl", ",", "ages", ",", 
     RowBox[{"x_", "/;", 
      RowBox[{"x", ">=", "7"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mean", "=", 
   RowBox[{"Mean", "[", "sdlogtrl7", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"err", "=", 
   RowBox[{
    RowBox[{"StandardDeviation", "[", "sdlogtrl7", "]"}], "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"Length", "[", "sdlogtrl7", "]"}], "]"}]}]}], ";"}]}], "Input",
