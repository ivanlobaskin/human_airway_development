Cell[CellGroupData[{

Cell["Define normalization function", "Subsection",
 CellChangeTimes->{{3.9869017561489677`*^9, 3.9869017855595512`*^9}, {
  3.9869022306282177`*^9, 
  3.9869022307724724`*^9}},ExpressionUUID->"0e0e140f-5f65-6f42-9afe-\
57636a1fe7fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"normalization", "[", "x_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"zmean", "=", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", "21"}], "]"}], ".", "x"}], "]"}], "/", 
        RowBox[{"Total", "[", "x", "]"}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        FractionBox[
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", "21"}], "]"}], "zmean"], ",", 
        RowBox[{"zmean", 
         FractionBox["x", 
          RowBox[{"Total", "[", "x", "]"}]]}]}], "}"}], "\[Transpose]"}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.986901939248867*^9, 3.986901991609745*^9}, {
  3.986902158214756*^9, 3.9869022218465214`*^9}, {3.9869022650177746`*^9, 
  3.986902265463648*^9}},
 CellLabel->
  "In[810]:=",ExpressionUUID->"d8fb7222-0803-3b48-a394-fd1e3b332eba"]
}, Open  ]],

