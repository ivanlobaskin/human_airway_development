Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"regularize", "=", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "<", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", 
       RowBox[{"Around", "[", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", 
            RowBox[{"10", "^", 
             RowBox[{"-", "10"}]}]}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ",", "#"}], 
      "]"}], "&"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "prevent", " ", "machine", " ", "error", " ", 
    "from", " ", "infinite", " ", 
    RowBox[{"errorbars", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"lrange", ",", "exppdf1"}], "}"}]}], "]"}], ",", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#1", ",", 
          RowBox[{"regularize", "@", 
           RowBox[{"Around", "[", 
            RowBox[{"#2", ",", "#3"}], "]"}]}]}], "}"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"lrange", ",", "simpdf1mean", ",", "simpdf1err"}], "}"}]}], 
      "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"lrange", ",", "exppdf2"}], "}"}]}], "]"}], ",", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#1", ",", 
          RowBox[{"regularize", "@", 
           RowBox[{"Around", "[", 
            RowBox[{"#2", ",", "#3"}], "]"}]}]}], "}"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"lrange", ",", "simpdf2mean", ",", "simpdf2err"}], "}"}]}], 
      "]"}]}], "}"}], ",", "\[IndentingNewLine]", "graphsettings", ",", 
   RowBox[{"ScalingFunctions", "->", "\"\<Log10\>\""}], ",", 
   RowBox[{"PlotRangePadding", "->", "None"}], ",", 
   RowBox[{"IntervalMarkers", "->", "\"\<Bands\>\""}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
