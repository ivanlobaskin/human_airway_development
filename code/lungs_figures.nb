43c88f1cb223"],

Cell["\<\
Note that data is stored as cumulative tip counts (e.g., total number of tips \
inside scaled radius s=0.5), so to obtain density, successive entries must be \
subtracted.\
\>", "Text",
 CellChangeTimes->{{3.9872321704732113`*^9, 
  3.9872322471766243`*^9}},ExpressionUUID->"f7c0efab-5c95-c646-b317-\
bfa09b67c44a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"srange", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"ds", ",", "smax", ",", "ds"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"normalizeddensity", "[", "data_", "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"Last", "[", "data", "]"}]], 
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{"Around", "[", 
        RowBox[{"#", ",", 
         RowBox[{"Sqrt", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
      RowBox[{"(", 
       RowBox[{"data", "-", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", "0", "}"}], ",", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{";;", 
             RowBox[{"-", "2"}]}], "]"}], "]"}]}], "]"}]}], ")"}]}], 
     RowBox[{
      RowBox[{"srange", "^", "3"}], "-", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "0", "}"}], ",", 
         RowBox[{"srange", "[", 
          RowBox[{"[", 
           RowBox[{";;", 
            RowBox[{"-", "2"}]}], "]"}], "]"}]}], "]"}], "^", "3"}]}]]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"srange", "-", 
         RowBox[{"ds", "/", "2"}]}], ",", 
        RowBox[{"normalizeddensity", "[", "data", "]"}]}], "}"}], 
      "\[Transpose]"}], ",", 
     RowBox[{"{", 
      RowBox[{"data", ",", 
       RowBox[{"{", 
        RowBox[{"eh3549", ",", "eh3685", ",", "eh3138", ",", "eh3822"}], 
        "}"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", "graphsettings", 
   ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1.2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "3.5"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"PlotMarkers", "->", 
