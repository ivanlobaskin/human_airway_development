Cell[CellGroupData[{

Cell["Supplementary FIG 6f", "Section",
 CellChangeTimes->{{3.988877903294401*^9, 
  3.988877910543272*^9}},ExpressionUUID->"e4a16978-d902-4946-8798-\
e0e68539a7b9"],

Cell[CellGroupData[{

Cell["Import data", "Subsection",
 CellChangeTimes->{{3.9888785281877365`*^9, 
  3.988878529611992*^9}},ExpressionUUID->"570332d0-85b6-4449-aafa-\
e5ba33b977a0"],

Cell[TextData[{
 "Only branches with (Strahler) order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"w", ">=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "df8a9c06-15db-d645-b3d4-1293a331b1f9"],
 " were included, as the lumen in younger branches was not fully developed \
and its diameter could not be accurately estimated.\nSubtree volume of a \
given branch was calculated as the sum of the volumes of all of its progeny. \
Individual branch volumes were estimated as ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[Pi]", 
     SuperscriptBox["d", "2"], "l"}], "4"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "39aae06a-3177-7842-8605-a29fa221d9d9"],
 ", where ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a06d5586-787a-2e4e-a8cd-91de8f6b0280"],
 " and ",
 Cell[BoxData[
  FormBox["l", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7bb624c1-2fc5-ba4e-a725-26fb2a0fcbf2"],
 " were the branch diameters and lengths extracted from the skeletonization."
}], "Text",
 CellChangeTimes->{{3.988878090289215*^9, 3.9888781702203484`*^9}, {
  3.988878544528101*^9, 
  3.9888787161880684`*^9}},ExpressionUUID->"39ebb1a0-b7db-454f-b2df-\
0eecadf95f4f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"diams", ",", "stvols"}], "}"}], "=", 
   RowBox[{
    RowBox[{"Import", "[", 
     RowBox[{"\"\<../data/lungs_supp_fig_6.xlsx\>\"", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Data\>\"", ",", "\"\<FIG S6f\>\""}], "}"}]}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"2", ";;"}], ",", 
      RowBox[{"2", ";;"}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.988877622501604*^9, 3.9888776372618313`*^9}, {
  3.9888787213305225`*^9, 3.988878731124092*^9}, {3.9888789233316326`*^9, 
