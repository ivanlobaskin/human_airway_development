Cell[CellGroupData[{

Cell["Estimate mean and SEM of \[Sigma] (for older than PCW7)", "Subsection",
 CellChangeTimes->{{3.9871579104609127`*^9, 3.987157958216732*^9}, {
  3.9871582555118237`*^9, 3.9871582778959007`*^9}, {3.987158322711458*^9, 
