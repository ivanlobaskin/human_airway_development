    RowBox[{"Import", "[", 
     RowBox[{"\"\<../data/lungs_supp_fig_6.xlsx\>\"", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Data\>\"", ",", "\"\<FIG S6g\>\""}], "}"}]}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"2", ";;"}], ",", 
      RowBox[{"2", ";;"}]}], "]"}], "]"}]}], ";"}]], "Input",
