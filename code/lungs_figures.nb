b40d3c0b9ce5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sdlogz7", "=", 
   RowBox[{"Pick", "[", 
    RowBox[{"sdlogz", ",", "ages", ",", 
     RowBox[{"x_", "/;", 
      RowBox[{"x", ">=", "7"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mean", "=", 
   RowBox[{"Mean", "[", "sdlogz7", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"err", "=", 
   RowBox[{
    RowBox[{"StandardDeviation", "[", "sdlogz7", "]"}], "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"Length", "[", "sdlogz7", "]"}], "]"}]}]}], ";"}]}], "Input",
