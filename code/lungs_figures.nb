Cell[CellGroupData[{

Cell["Generate fits", "Subsection",
 CellChangeTimes->{{3.9875861659283657`*^9, 
  3.987586168951418*^9}},ExpressionUUID->"7050c6e7-be7a-5f40-b866-\
9749f7e14e43"],

Cell["Pick only values of samples older than PCW7", "Text",
 CellChangeTimes->{{3.987586171705303*^9, 
  3.987586197176304*^9}},ExpressionUUID->"4900a6ad-d3e4-504d-958d-\
9ebce95ab0ff"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"lenm7", "=", 
   RowBox[{"Pick", "[", 
    RowBox[{"lenm", ",", "ages", ",", 
     RowBox[{"x_", "/;", 
      RowBox[{"x", ">=", "7"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"diamm7", "=", 
   RowBox[{"Pick", "[", 
    RowBox[{"diamm", ",", "ages", ",", 
     RowBox[{"x_", "/;", 
      RowBox[{"x", ">=", "7"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.987586200589655*^9, 3.987586248567045*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"2e3f47d1-ed02-0449-b88c-71d4dcb3574c"],

Cell["Generate exponential fits", "Text",
 CellChangeTimes->{{3.9875862513216095`*^9, 3.987586258136299*^9}, {
  3.987586388087599*^9, 3.9875864110163765`*^9}, {3.987586477381794*^9, 
  3.987586477557411*^9}},ExpressionUUID->"bf0c05d5-fc34-0c43-a3a4-\
72fdd16e95f0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fitlen", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cases", "[", 
         RowBox[{"ages", ",", 
          RowBox[{"x_", "/;", 
           RowBox[{"x", ">=", "7"}]}]}], "]"}], ",", 
        RowBox[{"Log", "@", "lenm7"}]}], "}"}], "\[Transpose]"}], ",", "x", ",",
      "x"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fitdiam", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cases", "[", 
          RowBox[{"ages", ",", 
           RowBox[{"x_", "/;", 
            RowBox[{"x", ">=", "7"}]}]}], "]"}], ",", "diamm7"}], "}"}], 
       "\[Transpose]"}], "[", 
      RowBox[{"[", 
       RowBox[{";;", 
        RowBox[{"-", "2"}]}], "]"}], "]"}], ",", "x", ",", "x"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.987586263646538*^9, 3.987586383148983*^9}, {
