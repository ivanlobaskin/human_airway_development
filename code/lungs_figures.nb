Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"regularize", "=", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "<", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", 
       RowBox[{"Around", "[", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", 
            RowBox[{"10", "^", 
             RowBox[{"-", "10"}]}]}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ",", "#"}], 
      "]"}], "&"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "prevent", " ", "machine", " ", "error", " ", 
    "from", " ", "infinite", " ", 
    RowBox[{"errorbars", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"wrange", ",", "nwexp"}], "}"}], "//", "Transpose"}], ",", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#1", ",", 
          RowBox[{"regularize", "@", 
           RowBox[{"Around", "[", 
            RowBox[{"#2", ",", "#3"}], "]"}]}]}], "}"}], "&"}], ",", 
       RowBox[{"{", 
