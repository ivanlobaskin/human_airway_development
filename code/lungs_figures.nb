Cell[CellGroupData[{

Cell["Import data", "Subsection",
 CellChangeTimes->{{3.9868995899309177`*^9, 
  3.9868995917549553`*^9}},ExpressionUUID->"bfe64d52-c93f-7a42-9c31-\
3ce260406be7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ages", ",", "nbranches"}], "}"}], "=", 
   RowBox[{
    RowBox[{"Import", "[", 
     RowBox[{"\"\<../data/lungs_fig_4.xlsx\>\"", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Data\>\"", ",", "\"\<FIG 4d\>\""}], "}"}]}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"2", ";;"}], ",", 
      RowBox[{"2", ";;"}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9868990298741245`*^9, 3.98689914007621*^9}, {
  3.9871592536719875`*^9, 3.987159270315943*^9}, {3.9875845958176556`*^9, 
  3.987584611852352*^9}, {3.9875848766656017`*^9, 3.9875848867442055`*^9}, {
  3.996322182369217*^9, 3.9963222083459225`*^9}, {3.9973348271984253`*^9, 
  3.9973348692942677`*^9}, {3.997334909887081*^9, 3.997335058255085*^9}, {
  3.997335134398876*^9, 3.9973351890865192`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"d1bc0098-a8ce-3348-a56f-73aafbc2fc03"]
