Cell[CellGroupData[{

Cell["\<\
Create a fit (linear fit to exponentiated Mean-log generations)\
\>", "Subsection",
 CellChangeTimes->{{3.9871579104609127`*^9, 
  3.987157958216732*^9}},ExpressionUUID->"28259c3f-6603-0146-9477-\
87f210f10385"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fit", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ages", ",", 
        RowBox[{"Exp", "@", "meanlogz"}]}], "}"}], "\[Transpose]"}], ",", "x",
      ",", "x"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9871579164603615`*^9, 3.987157917416977*^9}, {
  3.9871579628241577`*^9, 3.987158001239834*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"2841d709-3b48-f543-baef-7e164ec99b60"]
}, Open  ]],

