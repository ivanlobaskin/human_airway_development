455f7206d8ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ages", ",", "ntips", ",", "nsrftips"}], "}"}], "=", 
   RowBox[{
    RowBox[{"Import", "[", 
     RowBox[{"\"\<../data/lungs_fig_5.xlsx\>\"", ",", 
