Notebook[{

Cell[CellGroupData[{
Cell["Code for generating figures", "Title",
 CellChangeTimes->{{3.9868947428379955`*^9, 3.986894786062372*^9}, {
  3.9876547644145527`*^9, 
  3.9876547766386337`*^9}},ExpressionUUID->"ad304449-01ed-6e48-92f4-\
e82e80d63b96"],

Cell[CellGroupData[{

Cell["General guidelines", "Chapter",
 CellChangeTimes->{{3.9868994232073536`*^9, 
  3.9868994257690773`*^9}},ExpressionUUID->"c3f3db42-4572-de4d-98d0-\
f2a279e5c600"],

Cell["\<\
1) All sections start with importing data from the corresponding Excel \
spreadsheets \[OpenCurlyDoubleQuote]lungs_fig_X.xslx\[CloseCurlyDoubleQuote]. \
Current command assumes that the spreadsheets are are in the folder /data and \
the notebook is in the folder /code.
2) Almost all plots use a set of format instructions titled \
\[OpenCurlyDoubleQuote]graphsettings\[CloseCurlyDoubleQuote]. Run the line \
defining this command before attempting to generate plots.
3) For displaying fit statistics summaries, abbreviations of Mathematica \
commands \[OpenCurlyDoubleQuote]ParameterConfidenceIntervalTable\
\[CloseCurlyDoubleQuote] and \[OpenCurlyDoubleQuote]RSquared\
\[CloseCurlyDoubleQuote] are defined.
4) See Data Analysis notebook for demonstration on how key properties are \
extracted from skeleton files.\
\>", "Text",
 CellChangeTimes->{{3.9868991866817684`*^9, 3.9868992676107235`*^9}, {
  3.9868994079925175`*^9, 3.9868995284725456`*^9}, {3.986899564503332*^9, 
  3.9868995690814056`*^9}, {3.98689979423254*^9, 3.9868998433518143`*^9}, {
  3.9869038728875313`*^9, 3.986903920659981*^9}, {3.98691182132506*^9, 
  3.986911821820635*^9}, {3.986961918007242*^9, 3.9869619214470177`*^9}, {
  3.986961979828022*^9, 3.986962029767908*^9}, {3.987585199511801*^9, 
  3.9875852987122555`*^9}, {3.997509619385103*^9, 
  3.997509677431896*^9}},ExpressionUUID->"151e3ce5-f119-c346-bca5-\
c71534125216"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"graphsettings", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameStyle", "->", 
      RowBox[{"Directive", "[", "Black", "]"}]}], ",", 
     RowBox[{"AspectRatio", "->", "1"}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}], ",", 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Black", ",", 
        RowBox[{"FontSize", "->", "7.26"}]}], "}"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pcit", "=", 
   RowBox[{
    RowBox[{"#", "[", "\"\<ParameterConfidenceIntervalTable\>\"", "]"}], 
    "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r2", "=", 
   RowBox[{
    RowBox[{"#", "[", "\"\<RSquared\>\"", "]"}], "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.9868995488742523`*^9, 3.986899550905018*^9}, {
  3.986899849143791*^9, 3.9868998748453083`*^9}, {3.99544229942346*^9, 
  3.9954423080620747`*^9}, {3.9954583330173016`*^9, 3.995458333737852*^9}, {
  3.997335117261484*^9, 3.9973351281257668`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"965d0899-5b41-2f47-8c0d-1c7490168bbc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FIG 4", "Chapter",
 CellChangeTimes->{{3.9869006400716724`*^9, 
  3.9869006440439663`*^9}},ExpressionUUID->"4c1a3125-7591-0342-87f5-\
