Cell[CellGroupData[{

Cell["Pearson Correlation coefficient", "Subsection",
 CellChangeTimes->{{3.988880066269808*^9, 
  3.9888800728943977`*^9}},ExpressionUUID->"25715305-c297-4c4c-af6f-\
72c8819296a2"],

Cell["\<\
Strict adherence to Murray\[CloseCurlyQuote]s law predicts a negative \
correlation (anti-correlation).\
\>", "Text",
 CellChangeTimes->{{3.9888801035328274`*^9, 
  3.9888801519599857`*^9}},ExpressionUUID->"bc664c72-efef-2c45-b102-\
34e1a7a368ee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Correlation", "[", 
  RowBox[{
   FractionBox["d1", "d0"], ",", 
   FractionBox["d2", "d0"]}], "]"}]], "Input",
 CellChangeTimes->{{3.9888800760355644`*^9, 3.9888800870883636`*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"3c7db379-2e61-2e43-959b-476e544b85c0"],

Cell[BoxData["0.31807151204123246`"], "Output",
 CellChangeTimes->{3.9888800882015896`*^9, 3.995522527861311*^9},
 CellLabel->"Out[38]=",ExpressionUUID->"24d0cc03-97d1-e44c-8244-fd4fb22dd8e9"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Supplementary FIG 6h", "Section",
 CellChangeTimes->{{3.988887429229122*^9, 
  3.9888874356564007`*^9}},ExpressionUUID->"c7c6042f-72a9-b744-82d1-\
75c0a178fe17"],

Cell[CellGroupData[{

Cell["Import data", "Subsection",
 CellChangeTimes->{{3.9876593246320343`*^9, 
  3.9876593260719223`*^9}},ExpressionUUID->"9a126b18-c3db-0e41-9042-\
fa8067b28bb9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"nw", ",", "diamm", ",", "diamse"}], "}"}], "=", 
   RowBox[{
    RowBox[{"Import", "[", 
     RowBox[{"\"\<../data/lungs_supp_fig_6.xlsx\>\"", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Data\>\"", ",", "\"\<FIG S6h\>\""}], "}"}]}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"3", ";;"}], ",", 
      RowBox[{"2", ";;"}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9876593382518253`*^9, 3.987659371113449*^9}, {
  3.9888878223796864`*^9, 3.988887825582527*^9}, {3.996324551604244*^9, 
  3.996324570507244*^9}},ExpressionUUID->"b410119e-60c1-b843-9411-\
87e2d2b99a3b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Generate fit", "Subsection",
 CellChangeTimes->{{3.987659374708975*^9, 
  3.987659376086754*^9}},ExpressionUUID->"3123f1f5-eeb6-774d-bd13-\
3cc5fc9e275b"],

Cell[TextData[{
 "Points corresponding to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"w", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2ca47108-d43e-d34c-bbec-1387f603c2f0"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"w", "=", "10"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fc0f1871-2a83-5b42-abd6-c6c2fc4e5125"],
 " were not included in the fit as they did not follow the power law scaling \
trend.\nFor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"w", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a6402f77-afc6-b744-bcdf-f74cd28cb461"],
 ", this is likely due to the effect of tip bulb sizes.\nFor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"w", "=", "10"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e28c47d6-f0f9-1349-b5ef-d20a83416fa5"],
 ", this may be due to statistical noise, as the number of branches was very \
low ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["n", 
      RowBox[{"w", "=", "10"}]], "=", "2"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "18d88e5a-65c6-d944-af66-7965c0979b77"]
}], "Text",
 CellChangeTimes->{{3.9888879071772804`*^9, 
  3.988888052789383*^9}},ExpressionUUID->"eb1530e2-1e4a-0a41-ab89-\
5bed86c856d0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fit", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Log", "@", "nw"}], ",", 
         RowBox[{"Log", "@", "diamm"}]}], "}"}], "\[Transpose]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ";;", 
        RowBox[{"-", "2"}]}], "]"}], "]"}], ",", "x", ",", "x"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9876593771976643`*^9, 3.9876594210505524`*^9}, 
   3.9888816037314034`*^9, {3.988887885904825*^9, 3.9888878882032337`*^9}},
 CellLabel->
  "In[412]:=",ExpressionUUID->"109a6aa0-a317-ce4c-87c7-8dea2c1b40cf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Generate plot", "Subsection",
 CellChangeTimes->{{3.9876594231102753`*^9, 
  3.987659424756851*^9}},ExpressionUUID->"70b454a7-ea1f-4749-a055-\
3d4a4aeef9fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nw", ",", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
