}, Open  ]],

Cell[CellGroupData[{

Cell["Generate fit", "Subsection",
 CellChangeTimes->{{3.987655165977684*^9, 
  3.9876551692733192`*^9}},ExpressionUUID->"ed9a5ffe-6692-8648-be4c-\
3c395d7a5a67"],

Cell[TextData[{
 "As fraction of surface tips is expected to follow an inverse dependence \
with respect to time ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SubscriptBox["N", "S"], "/", "N"}], "\[Tilde]", 
     SuperscriptBox["t", 
      RowBox[{"-", "1"}]]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "960d4891-6833-024b-8126-529e05377e2d"],
 ", a linear fit of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "/", 
    SubscriptBox["N", "S"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9035c420-c015-e94b-99a6-51ca8eb377c5"],
 " against ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ab64827f-d2fc-0346-8567-7bd8c60aa7f4"],
 " is generated. Only samples older than PCW7.5 are used for fit, as for \
younger samples, the surface tip fraction is approximately unity."
}], "Text",
 CellChangeTimes->{{3.98765518484214*^9, 3.9876551884744473`*^9}, {
  3.9876557800247993`*^9, 3.9876558886654186`*^9}, {3.9876559511284504`*^9, 
  3.9876559632574577`*^9}, {3.987656034427084*^9, 3.9876560513363895`*^9}, {
  3.9876561844914875`*^9, 
  3.9876561846833897`*^9}},ExpressionUUID->"44074dd0-44ca-9145-bb82-\
201ccd6f4f55"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"srffrac", "=", 
   RowBox[{"nsrftips", "/", "ntips"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"srffrac75", "=", 
   RowBox[{"Pick", "[", 
    RowBox[{"srffrac", ",", "ages", ",", 
     RowBox[{"x_", "/;", 
      RowBox[{"x", ">=", "7.5"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fit", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cases", "[", 
         RowBox[{"ages", ",", 
          RowBox[{"x_", "/;", 
           RowBox[{"x", ">=", "7.5"}]}]}], "]"}], ",", 
        SuperscriptBox["srffrac75", 
         RowBox[{"-", "1"}]]}], "}"}], "\[Transpose]"}], ",", "x", ",", "x"}],
     "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9876551791995754`*^9, 3.9876551826534443`*^9}, 
   3.987655771756773*^9, {3.9876558903446617`*^9, 3.9876559244315968`*^9}, {
   3.987656053966341*^9, 3.9876560889591045`*^9}, {3.9876561452324963`*^9, 
   3.9876561457247562`*^9}, {3.987656187964651*^9, 3.9876561964737415`*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"a9fc6d17-2cb4-4a48-8649-2ac4865ac19c"]
}, Open  ]],

