     RowBox[{"\"\<Scaled radial distance, \
\!\(\*StyleBox[\"s\",FontSlant->\"Italic\"]\)\>\"", 
      ",", "\"\<Tip density, \[Rho]\>\""}], "}"}]}]}], "\[IndentingNewLine]", 
