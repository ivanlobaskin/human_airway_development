Cell[TextData[{
 "Junctions in which the parent branch had (Strahler) order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"w", "<=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fd1ad0cd-41b6-7e44-93d1-b82cfca70d2e"],
 " were excluded, as the diameters of their daughters could not be reliably \
estimated.\nHigher order junctions (trifurcations etc.) were excluded."
}], "Text",
 CellChangeTimes->{{3.9888797493410797`*^9, 3.988879749978836*^9}, {
  3.9888797803020153`*^9, 
  3.988879864926077*^9}},ExpressionUUID->"54c89042-c281-424e-92a2-\
3005df4b2059"],

