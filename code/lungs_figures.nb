      "graphsettings", ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Age (PCW)\>\"", 
         ",", "\"\<Concave hull volume (\!\(\*SuperscriptBox[\(\[Mu]m\), \
\(3\)]\))\>\""}], "}"}]}], ",", 
      RowBox[{"IntervalMarkers", "->", "\"\<Bands\>\""}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"{", "\"\<Concave hull volume\>\"", "}"}], ",", 
