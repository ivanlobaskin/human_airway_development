Cell[CellGroupData[{

Cell["Generate fit", "Subsection",
 CellChangeTimes->{{3.9888900241980305`*^9, 
  3.988890025747919*^9}},ExpressionUUID->"8c232e1e-1ca7-8045-84e5-\
08132f07ca6a"],

Cell[TextData[{
 "Only samples with volume greater than ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", 
    SuperscriptBox["10", "8"], " ", 
    SuperscriptBox["\[Mu]m", "3"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eea75a9c-d379-174e-b1e8-4890bc12a8d0"],
 " are used for fit."
}], "Text",
 CellChangeTimes->{{3.988890061341833*^9, 3.9888900687238483`*^9}, {
  3.988890105623516*^9, 
  3.98889014882209*^9}},ExpressionUUID->"3c2cdb0e-11ce-5240-899a-\
5a63b269d60f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fit", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{
     RowBox[{"Pick", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Log", "@", "volumes"}], ",", 
          RowBox[{"Log", "@", "nsrftips"}]}], "}"}], "\[Transpose]"}], ",", 
       "volumes", ",", 
       RowBox[{"x_", "/;", 
        RowBox[{"x", ">", 
         RowBox[{"2", " ", 
          SuperscriptBox["10", "8"]}]}]}]}], "]"}], ",", "x", ",", "x"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.988890026525429*^9, 3.9888900307722893`*^9}, {
  3.988890156307577*^9, 3.9888901679106503`*^9}, {3.988890297434332*^9, 
  3.9888903527943344`*^9}},
 CellLabel->
  "In[481]:=",ExpressionUUID->"dc06d205-f199-2140-b6f5-0358abc0f4e5"]
}, Open  ]],

