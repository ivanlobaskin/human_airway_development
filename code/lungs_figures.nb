          RowBox[{"Right", ",", "Bottom"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"ImageSize", "->", "165"}]}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"a", " ", "x"}], "+", "b"}], "]"}], ",", 
      RowBox[{"{", 
