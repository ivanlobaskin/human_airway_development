 RowBox[{
  RowBox[{"anglesresc", "=", 
   RowBox[{"90", "-", 
    RowBox[{"Abs", "[", 
     RowBox[{
      FractionBox["angles", "Degree"], "-", "90"}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.987657229279661*^9, 3.987657257000372*^9}},
 CellLabel->"In[82]:=",ExpressionUUID->"f1a3928e-6e22-a244-9423-b86ab612f902"],

