 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"nw", ",", "lenm", ",", "lense"}], "}"}], "=", 
   RowBox[{
    RowBox[{"Import", "[", 
     RowBox[{"\"\<../data/lungs_supp_fig_6.xlsx\>\"", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Data\>\"", ",", "\"\<FIG S6d\>\""}], "}"}]}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"3", ";;"}], ",", 
      RowBox[{"2", ";;"}]}], "]"}], "]"}]}], ";"}]], "Input",
