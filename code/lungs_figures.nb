Cell["\<\
This plot requires the function \[OpenCurlyDoubleQuote]CombinePlots\
\[CloseCurlyDoubleQuote], which can be imported from the Resource Function \
library.\
\>", "Text",
 CellChangeTimes->{{3.9947642067160473`*^9, 
  3.994764255692024*^9}},ExpressionUUID->"626668f9-cc49-5c41-b173-\
e16e9755356d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"cp", "=", 
   RowBox[{"ResourceFunction", "[", "\"\<CombinePlots\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"regularize", "=", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "<", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", 
       RowBox[{"Around", "[", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", 
            RowBox[{"10", "^", 
             RowBox[{"-", "6"}]}]}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ",", "#"}], 
      "]"}], "&"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "prevent", " ", "machine", " ", "error", " ", 
    "from", " ", "infinite", " ", 
    RowBox[{"errorbars", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Quiet", "@", 
  RowBox[{"cp", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ListPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"ages", ",", "volumes"}], "}"}], "]"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"regularize", "@", 
             RowBox[{"(", 
              SuperscriptBox[
               RowBox[{"fit", "[", "\"\<BestFitAround\>\"", "]"}], "3"], 
              ")"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "5.8", ",", "12", ",", "0.02"}], "}"}]}], 
         "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotMarkers", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<OpenMarkers\>\"", ",", "3"}], "}"}], ",", "None"}], 
        "}"}]}], ",", 
      RowBox[{"Joined", "->", 
       RowBox[{"{", 
        RowBox[{"False", ",", "True"}], "}"}]}], ",", 
      RowBox[{"ScalingFunctions", "->", "\"\<Log10\>\""}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"116", ",", "\"\<ColorList\>\""}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"4", ",", "14"}], "}"}], ",", 
