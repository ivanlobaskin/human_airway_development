Notebook[{

Cell[CellGroupData[{
Cell["Data analysis", "Title",
 CellChangeTimes->{{3.9869619563874416`*^9, 
  3.986961960291086*^9}},ExpressionUUID->"cdae4af9-4c3f-444f-b95b-\
9676fdc04fd9"],

Cell["\<\
Demonstration of how various properties are extracted from the network files. \
Sample included: EH4452 (PCW9.4) left upper lobe.
File must be imported and function definitions must be run before data \
extraction.\
\>", "Text",
 CellChangeTimes->{{3.9869646489608364`*^9, 3.986964702258415*^9}, {
  3.9869648595843544`*^9, 3.986964882738716*^9}, {3.9975042384353256`*^9, 
  3.9975042440049763`*^9}},ExpressionUUID->"61b34dee-a48d-494f-8dc7-\
2dd12a5a5c48"],

Cell[CellGroupData[{

Cell["Import file and define graph object", "Section",
 CellChangeTimes->{{3.986962845698328*^9, 
  3.9869628673807144`*^9}},ExpressionUUID->"60d3758b-33ea-c342-b7b4-\
786c9bc32051"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Import", " ", "network", " ", "edge", " ", 
    RowBox[{"file", "."}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"SetDirectory", "[", 
     RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"net", "=", 
     RowBox[{"Import", "[", 
      RowBox[{"\"\<..\\\\data\\\\FULL_clean_edge_list.dat\>\"", ",", 
       RowBox[{"\"\<HeaderLines\>\"", "->", "4"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xyz", "=", 
     RowBox[{
      RowBox[{"Import", "[", 
       RowBox[{"\"\<..\\\\data\\\\FULL_clean_node_positions.dat\>\"", ",", 
        RowBox[{"\"\<HeaderLines\>\"", "->", "4"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"2", ";;", "4"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Create", " ", "graph", " ", 
     RowBox[{"object", ".", " ", "\[IndentingNewLine]", "Branch"}], " ", 
     "lengths", " ", "and", " ", "diameters", " ", "are", " ", "stored", " ", 
     "as", " ", "annotations", " ", "to", " ", "the", " ", "corresponding", " ", 
     RowBox[{"edge", ".", " ", "Some"}], " ", "networks", " ", "have", " ", 
     "some", " ", "spurious", " ", "edges", " ", "attached", " ", "to", " ", 
     "the", " ", "root", " ", "due", " ", "to", " ", "difficulty", " ", "in", 
     " ", "segmenting", " ", "the", " ", "severed", " ", 
     RowBox[{"tissue", ".", " ", "\[IndentingNewLine]", "These"}], " ", "are",
      " ", "removed", " ", "so", " ", "that", " ", "the", " ", "root", " ", 
     "vertex", " ", "has", " ", "at", " ", "least", " ", "2", " ", 
     RowBox[{"children", ".", " ", "Note"}], " ", "that", " ", "the", " ", 
     "root", " ", "is", " ", "assumed", " ", "to", " ", "have", " ", "label", 
     " ", "1."}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"edges", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "\[UndirectedEdge]", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "&"}], "/@", "net"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"l", "=", 
     RowBox[{"net", "[", 
      RowBox[{"[", 
       RowBox[{";;", ",", "3"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"w", "=", 
     RowBox[{"net", "[", 
      RowBox[{"[", 
       RowBox[{";;", ",", "4"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gr", "=", 
     RowBox[{"Graph", "[", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Annotation", "[", 
          RowBox[{"#1", ",", 
           RowBox[{"{", 
            RowBox[{"#2", ",", "#3"}], "}"}]}], "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"edges", ",", "l", ",", "w"}], "}"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"VertexDegree", "[", 
        RowBox[{"gr", ",", "1"}], "]"}], "==", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"newroot", "=", 
        RowBox[{"First", "[", 
         RowBox[{"AdjacencyList", "[", 
          RowBox[{"gr", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"gr", "=", 
        RowBox[{"VertexDelete", "[", 
         RowBox[{"gr", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"gr", "=", 
        RowBox[{"VertexReplace", "[", 
         RowBox[{"gr", ",", 
          RowBox[{"{", 
           RowBox[{"newroot", "->", "1"}], "}"}]}], "]"}]}], ";"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9869622733636456`*^9, 3.9869623401629467`*^9}, 
   3.986962377474964*^9, {3.9974219135453224`*^9, 3.997421913924837*^9}, {
   3.997422000996443*^9, 3.9974220915640736`*^9}, {3.9974390704746017`*^9, 
   3.997439120247492*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"c66f0e16-001f-0d42-8303-c34dfc60ea33"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Function definitions", "Section",
 CellChangeTimes->{{3.986964848627371*^9, 
  3.986964854804283*^9}},ExpressionUUID->"de9c9b4e-a664-394d-8947-\
b5ce8a6e0a3b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Define", " ", "a", " ", "directed", " ", "graph"}], ",", " ", 
    RowBox[{
    "with", " ", "edge", " ", "direction", " ", "always", " ", "pointing", " ",
      "away", " ", "from", " ", "the", " ", 
     RowBox[{"root", ".", " ", "This"}], " ", "makes", " ", "it", " ", "easy",
      " ", "to", " ", "determine", " ", "which", " ", "of", " ", "two", " ", 
     "adjacent", " ", "vertices", " ", "is", " ", "more", " ", 
     RowBox[{"senior", "."}]}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"tg", "=", 
     RowBox[{"TreeGraph", "[", 
      RowBox[{"GraphTree", "[", 
       RowBox[{"gr", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tg", "=", 
     RowBox[{"VertexReplace", "[", 
      RowBox[{"tg", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "->", 
          RowBox[{"First", "[", "#", "]"}]}], "&"}], "/@", 
        RowBox[{"VertexList", "[", "tg", "]"}]}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"getz", "[", "i_", "]"}], ":=", 
     RowBox[{
      RowBox[{"getz", "[", "i", "]"}], "=", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"gr", ",", "1", ",", "i"}], "]"}]}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "vertex", " ", "generation"}], "*)"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"getp", "[", "v_", "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"v", "==", "1"}], ",", "Null", ",", 
       RowBox[{
        RowBox[{"VertexInComponent", "[", 
         RowBox[{"tg", ",", "v", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "extract", " ", "parent", " ", "vertex", " ", 
     "of", " ", "a", " ", "given", " ", 
     RowBox[{"vertex", "."}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Shorthand", " ", "commands", " ", "to", " ", "extract", " ", "branch", " ",
       "length", " ", "and", " ", 
      RowBox[{"diameter", ".", " ", "It"}], " ", "is", " ", "easier", " ", 
      "to", " ", "work", " ", "with", " ", "vertices", " ", "than", " ", 
      "edges"}], ",", " ", 
     RowBox[{
     "so", " ", "the", " ", "length", " ", "of", " ", "a", " ", "vertex", " ",
       "is", " ", "defined", " ", "as", " ", "the", " ", "length", " ", "of", 
      " ", "the", " ", "branch", " ", "connecting", " ", "the", " ", "vertex",
       " ", "to", " ", "its", " ", 
      RowBox[{"parent", "."}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"getl", "[", "v_", "]"}], ":=", 
     RowBox[{
      RowBox[{"AnnotationValue", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"gr", ",", 
          RowBox[{"v", "\[UndirectedEdge]", 
           RowBox[{"getp", "[", "v", "]"}]}]}], "}"}], ",", "Annotation"}], 
       "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"getw", "[", "v_", "]"}], ":=", 
     RowBox[{
      RowBox[{"AnnotationValue", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"gr", ",", 
          RowBox[{"v", "\[UndirectedEdge]", 
           RowBox[{"getp", "[", "v", "]"}]}]}], "}"}], ",", "Annotation"}], 
       "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
      "Extract", " ", "total", " ", "length", " ", "of", " ", "branches", " ",
        "going", " ", "from", " ", "the", " ", "root", " ", "to", " ", "a", " ",
        "given", " ", 
       RowBox[{"vertex", ".", " ", "This"}], " ", "can", " ", "be", " ", 
       "used", " ", "to", " ", "extract", " ", "tip"}], "-", "to", "-", 
      RowBox[{"root", " ", "length"}]}], ",", " ", 
     RowBox[{"if", " ", "applied", " ", "to", " ", "end", " ", "vertices", " ", 
      RowBox[{"(", "leaves", ")"}], " ", "of", " ", "the", " ", 
      RowBox[{"network", "."}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "trl", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"trl", "[", "v_", "]"}], ":=", 
     RowBox[{
      RowBox[{"trl", "[", "v", "]"}], "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"v", "==", "1"}], ",", "0", ",", 
        RowBox[{
         RowBox[{"getl", "[", "v", "]"}], "+", 
         RowBox[{"trl", "@", 
          RowBox[{"First", "@", 
           RowBox[{"VertexInComponent", "[", 
            RowBox[{"tg", ",", "v", ",", 
             RowBox[{"{", "1", "}"}]}], "]"}]}]}]}]}], "]"}]}]}], ";"}], "\n",
    "\n", 
   RowBox[{
    RowBox[{"ends", "=", 
     RowBox[{"VertexList", "[", 
      RowBox[{"gr", ",", 
       RowBox[{"v_", "/;", 
        RowBox[{
         RowBox[{"VertexDegree", "[", 
          RowBox[{"gr", ",", "v"}], "]"}], "==", "1"}]}]}], "]"}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"List", " ", "of", " ", "end", " ", "vertices", " ", 
     RowBox[{"(", "tips", ")"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Branch", " ", "order", " ", 
     RowBox[{"(", 
      RowBox[{"Strahler", " ", "method"}], ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "bos", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"bos", "[", "v_", "]"}], ":=", 
     RowBox[{
      RowBox[{"bos", "[", "v", "]"}], "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexDegree", "[", 
          RowBox[{"gr", ",", "v"}], "]"}], "==", "1"}], ",", "1", ",", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"bo", "=", 
            RowBox[{"bos", "/@", 
             RowBox[{"VertexOutComponent", "[", 
              RowBox[{"tg", ",", "v", ",", 
               RowBox[{"{", "1", "}"}]}], "]"}]}]}], "}"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"Equal", "@@", "bo"}], ",", 
            RowBox[{
             RowBox[{"bo", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "+", "1"}], ",", 
            RowBox[{"Max", "[", "bo", "]"}]}], "]"}]}], "]"}]}], "]"}]}]}], 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"ends2", "=", 
     RowBox[{"VertexList", "[", 
      RowBox[{"gr", ",", 
       RowBox[{"v_", "/;", 
        RowBox[{
         RowBox[{"bos", "[", "v", "]"}], "==", "2"}]}]}], "]"}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"List", " ", "of", " ", 
     RowBox[{"(", "Strahler", ")"}], " ", "order", " ", "2", " ", 
     "branches"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"branchvector", "[", "i_", "]"}], ":=", 
     RowBox[{
      RowBox[{"xyz", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "-", 
      RowBox[{"xyz", "[", 
       RowBox[{"[", 
        RowBox[{"getp", "[", "i", "]"}], "]"}], "]"}]}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
    "Vector", " ", "pointing", " ", "to", " ", "given", " ", "vertex", " ", 
     "from", " ", "its", " ", "parent", " ", 
     RowBox[{"vertex", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"angle", "[", 
      RowBox[{"v1_", ",", "v2_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"ArcCos", "[", 
       FractionBox[
        RowBox[{"Dot", "[", 
         RowBox[{"v1", ",", "v2"}], "]"}], 
        RowBox[{
         RowBox[{"Norm", "[", "v1", "]"}], 
         RowBox[{"Norm", "[", "v2", "]"}]}]], "]"}], 
      SuperscriptBox["\[Degree]", 
       RowBox[{"-", "1"}]]}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"Angle", " ", "between", " ", "two", " ", "vectors", " ", "in", " ", 
     RowBox[{"degrees", "."}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sem", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"StandardDeviation", "[", "#", "]"}], "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Length", "[", "#", "]"}], "]"}]}], "&"}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"Standard", " ", "error", " ", "of", " ", "the", " ", "mean"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"cov", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"StandardDeviation", "[", "#", "]"}], "/", 
       RowBox[{"Mean", "[", "#", "]"}]}], "&"}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"Coefficient", " ", "of", " ", "variation"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "concave", " ", "hull"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"voxelsize", "=", "7"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ccvhl", "=", 
     RowBox[{"ConcaveHullMesh", "[", "xyz", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Identify", " ", "surface", " ", "tips", " ", "and", " ", "bulk", " ", 
     "tips"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ccvhlsrf", "=", 
     RowBox[{"RegionBoundary", "[", "ccvhl", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"srftips", "=", 
     RowBox[{"Cases", "[", 
      RowBox[{"ends", ",", 
       RowBox[{"i_", "/;", 
        RowBox[{"RegionMember", "[", 
         RowBox[{"ccvhlsrf", ",", 
          RowBox[{"xyz", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blktips", "=", 
     RowBox[{"Complement", "[", 
      RowBox[{"ends", ",", "srftips"}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Identify", " ", "vertices", " ", "belonging", " ", "to", " ", "core", " ",
      "network", " ", "and", " ", "ancillary", " ", "subtrees"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"corenetwork", "=", 
     RowBox[{"VertexInComponent", "[", 
      RowBox[{"tg", ",", "srftips"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ancillarysubtrees", "=", 
     RowBox[{"Complement", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "gr", "]"}], ",", "corenetwork"}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9869632205642624`*^9, 3.986963291925167*^9}, {
  3.997422155349249*^9, 3.9974221571721954`*^9}, {3.997422224205715*^9, 
  3.9974224507470684`*^9}, {3.9974224989552155`*^9, 3.9974225160063343`*^9}, {
