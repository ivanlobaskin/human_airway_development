Cell[CellGroupData[{

Cell["Radial density profile (Fig. 5e)", "Subsection",
 CellChangeTimes->{{3.9974396556256676`*^9, 3.9974397039609146`*^9}, {
  3.997506173392969*^9, 
  3.997506174477215*^9}},ExpressionUUID->"dd15f5ca-368f-644e-8310-\
ef5605891f46"],

Cell["\<\
Includes addition of random distance to define hull (see Supplementary \
Information).\
\>", "Text",
 CellChangeTimes->{{3.997506176925953*^9, 
  3.9975061787206516`*^9}},ExpressionUUID->"e1dfd061-f6c0-0e41-a84e-\
21d6c05963fe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"xm", "=", 
   RowBox[{"RegionCentroid", "[", "ccvhl", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"newpoints", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"#", "+", 
       RowBox[{
        RowBox[{"RandomVariate", "[", 
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"30", ",", "10"}], "]"}], "]"}], 
        FractionBox[
         RowBox[{"#", "-", "xm"}], 
         RowBox[{"Norm", "[", 
          RowBox[{"#", "-", "xm"}], "]"}]]}]}], ")"}], "&"}], "/@", "xyz"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"newhl", "=", 
   RowBox[{"ConcaveHullMesh", "[", "newpoints", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x0", "=", 
   RowBox[{"RegionCentroid", "[", "newhl", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ds", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"srange", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"ds", ",", "1.2", ",", "ds"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"scldhl", "=", 
         RowBox[{"Scale", "[", 
          RowBox[{"newhl", ",", "s", ",", "x0"}], "]"}]}], "}"}], ",", 
       RowBox[{"Count", "[", 
        RowBox[{"ends", ",", 
         RowBox[{"i_", "/;", 
          RowBox[{"RegionMember", "[", 
           RowBox[{"scldhl", ",", 
            RowBox[{"xyz", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}]}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", "srange"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tipdensity", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"Last", "[", "data", "]"}]], 
    FractionBox[
     RowBox[{"(", 
      RowBox[{"data", "-", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "0", "}"}], ",", 
         RowBox[{"data", "[", 
          RowBox[{"[", 
           RowBox[{";;", 
            RowBox[{"-", "2"}]}], "]"}], "]"}]}], "]"}]}], ")"}], 
     RowBox[{
      RowBox[{"srange", "^", "3"}], "-", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "0", "}"}], ",", 
         RowBox[{"srange", "[", 
          RowBox[{"[", 
           RowBox[{";;", 
            RowBox[{"-", "2"}]}], "]"}], "]"}]}], "]"}], "^", "3"}]}]]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"srange", "-", 
        RowBox[{"0.5", " ", "ds"}]}], 
       ",", "\"\<Scaled radial distance, \
\!\(\*StyleBox[\"s\",FontSlant->\"Italic\"]\):\>\""}], "]"}], ",", 
     RowBox[{"Prepend", "[", 
      RowBox[{"tipdensity", ",", "\"\<Tip density, \[Rho]:\>\""}], "]"}]}], 
    "}"}], "//", "TableForm"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9974397095669785`*^9, 3.9974397122339783`*^9}, {
  3.997439748758196*^9, 3.9974398442425976`*^9}, {3.9974399084148617`*^9, 
  3.997439959292536*^9}},
 CellLabel->
