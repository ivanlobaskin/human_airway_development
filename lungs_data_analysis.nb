Cell["Count number of branches by branch order (Fig. 4j; Fig. 6d)", \
"Subsection",
 CellChangeTimes->{{3.9869639807389145`*^9, 3.986963988784645*^9}, {
  3.9974329763452873`*^9, 3.997432988888254*^9}, {3.9974386708392296`*^9, 
