   "List", " ", "of", " ", "nodes", " ", "with", " ", "exactly", " ", "two", " ",
     "child", " ", 
    RowBox[{"nodes", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Cross", "@@", 
       RowBox[{"(", 
        RowBox[{"branchvector", "/@", 
         RowBox[{"VertexOutComponent", "[", 
          RowBox[{"tg", ",", "i", ",", 
           RowBox[{"{", "1", "}"}]}], "]"}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "nodes"}], "}"}]}], "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "List", " ", "of", " ", "vectors", " ", "normal", " ", "to", " ", "plane", 
    " ", "of", " ", "branching", " ", "at", " ", "given", " ", 
    RowBox[{"vertex", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nodes2", "=", 
    RowBox[{"Cases", "[", 
     RowBox[{"nodes", ",", 
      RowBox[{"j_", "/;", 
       RowBox[{"MemberQ", "[", 
        RowBox[{"nodes", ",", 
         RowBox[{"getp", "[", "j", "]"}]}], "]"}]}]}], "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "List", " ", "of", " ", "members", " ", "of", " ", "nodes", " ", "whose", " ",
     "parents", " ", "are", " ", "also", " ", "memebers", " ", "of", " ", 
    RowBox[{"nodes", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"b", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Cross", "[", 
       RowBox[{
        RowBox[{"branchvector", "[", "i", "]"}], ",", 
        RowBox[{
         RowBox[{"Pick", "[", 
          RowBox[{"n", ",", "nodes", ",", 
           RowBox[{"getp", "[", "i", "]"}]}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "nodes2"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"List", " ", "of", " ", "vectors", " ", 
    StyleBox["b",
     FontWeight->"Bold"], 
    StyleBox[" ",
     FontWeight->"Bold"], 
    StyleBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"see", " ", "Supplementary", " ", 
        RowBox[{"Fig", ".", " ", "6"}], "a", " ", "and", " ", "Supplementary",
         " ", "Information"}], ")"}], "."}],
     FontWeight->"Plain"]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"alignmentangles", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"90", "-", 
      RowBox[{"Abs", "[", 
       RowBox[{"90", "-", 
        RowBox[{"angle", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Pick", "[", 
            RowBox[{"n", ",", "nodes", ",", "i"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"Pick", "[", 
            RowBox[{"b", ",", "nodes2", ",", "i"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}]}], 
     "\[IndentingNewLine]", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "nodes2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Mean alignment angle: \>\"", ",", 
   RowBox[{"Mean", "[", "alignmentangles", "]"}]}], "]"}]}], "Input",
