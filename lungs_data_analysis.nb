1dff01d57ab2"],

Cell["\<\
Note that due to the merging rule of the Strahler order scheme, only branches \
whose parent has a higher order are counted.\
\>", "Text",
 CellChangeTimes->{{3.986963991489998*^9, 
  3.98696402496154*^9}},ExpressionUUID->"2df7881a-cbb1-2547-89d3-\
71063b47bd5c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"wmax", "=", 
   RowBox[{"bos", "[", "1", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ws", ",", 
       RowBox[{"VertexCount", "[", 
        RowBox[{"gr", ",", 
         RowBox[{"v_", "/;", 
          RowBox[{
           RowBox[{
            RowBox[{"bos", "[", "v", "]"}], "==", "ws"}], "&&", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"bos", "[", 
               RowBox[{"getp", "[", "v", "]"}], "]"}], ">", 
              RowBox[{"bos", "[", "v", "]"}]}], "||", 
             RowBox[{"v", "==", "1"}]}], ")"}]}]}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ws", ",", "wmax"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rownames", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Order (Strahler): \>\"", 
     ",", "\"\<Number of branches, \!\(\*StyleBox[SubscriptBox[\"n\", \
\"w\"],FontSlant->\"Italic\"]\): \>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{"data", ",", "rownames"}], "]"}], "//", "Transpose"}], "//", 
   "TableForm"}], "]"}]}], "Input",
 CellChangeTimes->{{3.986964031095236*^9, 3.9869641101351624`*^9}, {
  3.9869643545375957`*^9, 3.986964420193884*^9}, {3.986966032192562*^9, 
  3.98696603427614*^9}, {3.986966231461794*^9, 3.9869662319887905`*^9}, {
  3.9974307122437363`*^9, 3.997430759439726*^9}, {3.997431079083967*^9, 
  3.9974311198512897`*^9}},
 CellLabel->
