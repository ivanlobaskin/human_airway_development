Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"zmax", "=", 
   RowBox[{"VertexEccentricity", "[", 
    RowBox[{"gr", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{"VertexCount", "[", 
        RowBox[{"gr", ",", 
         RowBox[{"v_", "/;", 
          RowBox[{
