Cell[CellGroupData[{

Cell["\<\
Determine number of generations as surface tip and as bulk tip (Supplementary \
Fig. 7a, b)\
\>", "Subsection",
 CellChangeTimes->{{3.9974430929445286`*^9, 3.9974431677890816`*^9}, 
   3.9975061627015705`*^9},ExpressionUUID->"59fb8ab2-7858-7e47-aa7e-\
fb9bd4483378"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"lcna", "[", "i_", "]"}], ":=", 
   RowBox[{"First", "[", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"VertexInComponent", "[", 
       RowBox[{"tg", ",", "i"}], "]"}], ",", 
      RowBox[{
       RowBox[{"MemberQ", "[", 
        RowBox[{"corenetwork", ",", "#"}], "]"}], "&"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"getz", "[", "i", "]"}], "-", 
        RowBox[{"getz", "[", 
         RowBox[{"lcna", "[", "i", "]"}], "]"}]}], ",", 
       RowBox[{"getz", "[", 
        RowBox[{"lcna", "[", "i", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "ends"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fit", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{"data", ",", "x", ",", "x"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Bulk/surface branch time, \!\(\*SubscriptBox[\(\[Tau]\), \
\(b\)]\)/\!\(\*SubscriptBox[\(\[Tau]\), \(s\)]\): \>\"", ",", 
   RowBox[{"-", 
    RowBox[{
     RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Bulk/surface branch time error: \>\"", ",", 
   RowBox[{"Quiet", "@", 
    RowBox[{
     RowBox[{"fit", "[", "\"\<ParameterEstimates\>\"", "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"2", ",", "\"\<StandardError\>\""}], "]"}], "]"}]}]}], 
  "]"}]}], "Input",
