Cell["Extract branching ratio (Fig. 6e and Supplementary Fig. 5d)", "Text",
 CellChangeTimes->{{3.986966176561905*^9, 3.98696618060746*^9}, {
  3.997449652705494*^9, 
  3.9974496660662174`*^9}},ExpressionUUID->"e463127e-a2ae-6145-af50-\
9dfb932cdc66"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"wmax", "=", 
   RowBox[{"bos", "[", "1", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ws", ",", 
       RowBox[{"VertexCount", "[", 
        RowBox[{"gr", ",", 
         RowBox[{"v_", "/;", 
          RowBox[{
           RowBox[{
            RowBox[{"bos", "[", "v", "]"}], "==", "ws"}], "&&", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"bos", "[", 
               RowBox[{"getp", "[", "v", "]"}], "]"}], ">", 
              RowBox[{"bos", "[", "v", "]"}]}], "||", 
             RowBox[{"v", "==", "1"}]}], ")"}]}]}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ws", ",", "wmax"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fit", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{
     RowBox[{"Log", "@", 
      RowBox[{"data", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", "n", ",", "n"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Rb", "=", 
   RowBox[{"Exp", "[", 
    RowBox[{"-", 
     RowBox[{
      RowBox[{"fit", "'"}], "[", "0", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Branching ratio, \!\(\*StyleBox[SubscriptBox[\"R\", \
